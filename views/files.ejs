<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <div class="container">
        <%-  include( 'navigation') %>
        <aside>
            <!-- Open Folder logo/svg -->
             <h3><%= locals.folder.name %></h3>
        </aside>
        <main>
            <form action="/<%= locals.user.id %>/<%= locals.folder.id %>/addNewFile?folderName=<%= locals.folder.name %>" method="post" enctype="multipart/form-data" >
                <% if ( locals.error ) { %>
                    <p><%= locals.error %></p>
                <% } %>
                <input type="file" name="newFile" >
                <button type="submit">Add New File</button>
            </form>
            <% if ( locals.folder.files?.length <= 0 ) { %>
                <p>Folder is empty.. add files to begin</p>
            <% } else { %>
                <ul>
                    <% locals.folder.files.forEach( file => { %>
                        <li>
                            <div>
                                <!-- add a file profile here -->
                                <h3><%= file.name.split( '-' )[0] %></h3>
                                <p>.<%= file.name.split( '.' )[1] %></p>
                                <% if ( !file.details ) { %>
                                <a href="/<%= locals.user.id %>/<%= locals.folder.id %>/<%= file.id %>/showFileDetails" >
                                    Show File Details
                                </a>
                                <a href="/<%= locals.user.id %>/<%= locals.folder.id %>/<%= file.id %>/downloadFile?fileName=<%=file.name %>&mimetype=<%= file.mimetype %>&publicId=<%= file.publicId %>" >
                                    Download File
                                </a>
                                <% } %>
                            </div>
                            <% if ( file.details ) { %>
                                <div class="fileDetailsDiv">
                                    <p>File Size: <%= (file.size/ ( 1024 * 1024) ).toFixed(2) %> MB</p>
                                    <p>Mimetype: <%= file.mimetype %></p>
                                    <p>CreatedAt: <%= file.createdAt %></p>
                                    <a href="/<%= locals.user.id %>/<%= locals.folder.id %>/<%= file.id %>/hideFileDetails">
                                        Hide File Details
                                    </a>
                                </div>
                            <% } %>
                            
                        </li>
                    <% }) %>
                </ul>
            <% } %>
        </main>
        <%- include( 'footer' ) %>
    </div>   
</body>
</html>