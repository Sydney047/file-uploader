<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <%- include('navigation') %>
    <main>
        <div class="loginButtonsDiv">
            <button><a href="/sign-up">Sign Up</a></button>
            <button><a href="/login">Login</a></button>
        </div>
        <% if ( locals.login ) { %>
            <%- include('login') %>
        <% } else { %>
            <%- include('sign-up') %>
        <% } %>
    </main>
    <%- include('footer') %>
</body>
</html>