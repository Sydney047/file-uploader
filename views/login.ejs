<form action="/login" method="post" onsubmit="e.preventDefault();" class="loginForm" >
    <% if ( locals.errors && locals.errors.length > 0 ) { %>
        <ul class="errorMessages">
            <% locals.errors.forEach( error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <% if ( locals.failedLogin ) {  %>
        <ul>
            <li><%= locals.failedLogin %></li>
        </ul>
    <% } %>
    
    <label for="username">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> 
            <circle cx="12" cy="6" r="4" fill="#091413"></circle> <path d="M20 17.5C20 19.9853 20 22 12 22C4 22 4 19.9853 4 17.5C4 15.0147 7.58172 13 12 13C16.4183 13 20 15.0147 20 17.5Z" fill="#091413"></path> </g>
        </svg>
        Username: 
        <input type="text" id="username" name="username" required placeholder="Laina87..." >
    </label>
    <label for="password">
