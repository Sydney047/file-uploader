<form action="/sign-up" method="post" onsubmit="e.preventDefault();" class="loginForm">
    <% if ( locals.errors && locals.errors.length > 0 ) { %>
        <ul class="errorMessages">
            <% locals.errors.forEach( error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>
    <label for="username">Username: <input type="text" id="username" name="username" required></label>
    <label for="email">Email: <input type="email" id="email" name="email" required></label>
    <label for="password">Password: <input type="password" id="password" name="password" required></label>
    <label for="confirmPassword">Confirm Password: <input type="password" id="confirmPassword" name="confirmPassword" required></label>
    <button type="submit">Sign Up</button>
</form>